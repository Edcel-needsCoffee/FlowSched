{
  "name": "flowsched",
  "version": "0.1.0",
  "private": true,
  "description": "FlowSched — Industrial Engineering Faculty Workload Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate:dev": "npm run migrate:dev --workspace apps/api",
    "seed": "npm run seed --workspace apps/api"
  },
  "engines": {
    "node": ">=20"
  }
}
